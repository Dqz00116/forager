# OpenCode Go API key —— 从 https://opencode.ai 后台生成，oc_sk_ 前缀
OPENCODE_API_KEY=oc_sk_your_key_here

# 驱动爬虫 agent 的模型（OpenCode Go 目录中的模型 ID）
# 免费档：muse-spark-1.3-contributor / muse-spark-1.2-contributor
CRAWLER_MODEL=muse-spark-1.3-contributor

# 可选：固定 OpenCode 会话路由 ID（留空则每次运行自动生成）
# OPENCODE_SESSION_ID=
